<Window x:Class="ClaudeLauncher.App.ChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="改动的文件" Height="780" Width="1160" MinWidth="760" MinHeight="460"
        Icon="app.ico"
        WindowStartupLocation="Manual"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- A file changed: its name, where it is, how much and how often. -->
        <DataTemplate x:Key="FileTemplate">
            <Grid Margin="2,5,4,5" ToolTip="{Binding Path}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding Tag, Mode=OneWay}"
                         FontSize="11" Foreground="{DynamicResource InfoBrush}"/>
                </TextBlock>
                <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12">
                    <Run Text="{Binding AddedText, Mode=OneWay}" Foreground="{DynamicResource DiffAddTextBrush}"/><Run
                         Text=" "/><Run Text="{Binding RemovedText, Mode=OneWay}" Foreground="{DynamicResource DiffRemoveTextBrush}"/>
                </TextBlock>
                <TextBlock Grid.Row="1" Text="{Binding Folder}" FontSize="11.5" Foreground="{DynamicResource FaintBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,2,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CountText}" FontSize="11.5"
                           Foreground="{DynamicResource FaintBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- One line of a diff; a change's heading is a line of its own, set apart. -->
        <DataTemplate x:Key="DiffTemplate">
            <Border x:Name="Row" Padding="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OldNo" Text="{Binding OldNo}" HorizontalAlignment="Right" Margin="0,0,8,0"
                               Foreground="{DynamicResource FaintBrush}"/>
                    <TextBlock x:Name="NewNo" Grid.Column="1" Text="{Binding NewNo}" HorizontalAlignment="Right" Margin="0,0,8,0"
                               Foreground="{DynamicResource FaintBrush}"/>
                    <TextBlock x:Name="Sign" Grid.Column="2" Text="{Binding Sign}"/>
                    <TextBlock x:Name="Body" Grid.Column="3" Text="{Binding Text}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="+">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffAddBrush}"/>
                    <Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource DiffAddTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="-">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffRemoveBrush}"/>
                    <Setter TargetName="Sign" Property="Foreground" Value="{DynamicResource DiffRemoveTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="@">
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="…">
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource FaintBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="H">
                    <Setter TargetName="Row" Property="Margin" Value="0,14,0,4"/>
                    <Setter TargetName="Row" Property="Padding" Value="8,5,12,5"/>
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource RaisedBrush}"/>
                    <Setter TargetName="Body" Property="Grid.Column" Value="0"/>
                    <Setter TargetName="Body" Property="Grid.ColumnSpan" Value="4"/>
                    <Setter TargetName="Body" Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
                    <Setter TargetName="Body" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="OldNo" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="NewNo" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Sign" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.55"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleLine" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="SummaryLine" Grid.Row="1" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,12"
                   TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" Text="正在读取对话记录…"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====================================================== files -->
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBox x:Name="FilterBox" Padding="28,5,8,5" VerticalContentAlignment="Center"
                             TextChanged="Filter_TextChanged" AutomationProperties.Name="筛选文件"
                             ToolTip="按文件名或路径筛选"/>
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE71C;" Foreground="{StaticResource FaintBrush}"
                               Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    <TextBlock x:Name="FilterHint" Text="筛选文件" Foreground="{StaticResource FaintBrush}" Margin="30,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <ListBox x:Name="FileList" ItemTemplate="{StaticResource FileTemplate}" SelectionChanged="FileList_SelectionChanged"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True" AutomationProperties.Name="改动的文件"
                         Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" Focusable="False"/>

            <!-- ======================================================= diff -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button x:Name="CopyButton" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,0" Click="Copy_Click"
                            IsEnabled="False" ToolTip="把这个文件的全部改动按 diff 格式复制到剪贴板">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8C8;" Margin="0,0,7,0"/>
                            <TextBlock Text="复制改动"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="RevealButton" DockPanel.Dock="Right" Padding="10,5" Click="Reveal_Click" IsEnabled="False"
                            ToolTip="在资源管理器里选中这个文件（它现在的样子可能已和记录里不同）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE838;" Margin="0,0,7,0"/>
                            <TextBlock Text="在文件夹中显示"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="PathLine" FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                </DockPanel>
                <Grid>
                    <ListBox x:Name="DiffList" ItemTemplate="{StaticResource DiffTemplate}" FontFamily="{StaticResource MonoFont}"
                             FontSize="12.5" AutomationProperties.Name="改动内容"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="460" Style="{StaticResource Muted}" FontSize="13"
                               Visibility="Collapsed"/>
                </Grid>
            </DockPanel>
        </Grid>

        <TextBlock Grid.Row="3" Margin="2,12,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource FaintBrush}"
                   Text="读自对话记录，不读磁盘上的文件：显示的是当时记下的改动，文件现在可能已经不同。只包括 Edit、Write、MultiEdit、NotebookEdit 与 apply_patch，子代理、子任务做的改动也在内（工具名后标出）；用命令行或脚本改的文件不在其中。半透明的是工具报告失败的尝试。"/>
    </Grid>
</Window>
