<Window x:Class="ClaudeLauncher.App.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="会话管家" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Margin="22,18,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="Glyph" Grid.RowSpan="2" Style="{StaticResource IconGlyph}" FontSize="22"
                   Margin="0,0,14,0" VerticalAlignment="Top"/>
        <TextBlock x:Name="Heading" Grid.Column="1" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <!-- Selectable: an error message is exactly the text a person wants to paste somewhere. -->
        <TextBox x:Name="Body" Grid.Row="1" Grid.Column="1" Style="{StaticResource SelectableText}"
                 Margin="0,8,0,0" MaxHeight="420" Foreground="{StaticResource SubtleTextBrush}"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="PrimaryButton" MinWidth="92" IsDefault="True" Style="{StaticResource ClaudeButton}"
                    Click="Primary_Click"/>
            <Button x:Name="SecondaryButton" MinWidth="92" Margin="8,0,0,0" Click="Secondary_Click"
                    Visibility="Collapsed"/>
            <Button x:Name="CancelButton" MinWidth="92" Margin="8,0,0,0" IsCancel="True" Click="Cancel_Click"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
