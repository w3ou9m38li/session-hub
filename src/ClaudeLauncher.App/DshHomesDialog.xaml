<Window x:Class="ClaudeLauncher.App.DshHomesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek Harness 的会话位置" Width="600" SizeToContent="Height" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <StackPanel Margin="20,18,20,16">
        <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                   Text="读取 DeepSeek Harness 的会话"/>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource SubtleTextBrush}"
                   Text="DeepSeek Harness（dsh）把会话存在它的数据目录（DSH_HOME）里，默认是用户文件夹下的 .dsh。用启动脚本把 DSH_HOME 指到别处的——比如本地部署的 data 文件夹——在这里添加那个文件夹：选部署的根目录或里面的 data 都可以。会话管家只读其中的 sessions 文件夹和工作区记录，不读同一目录里的模型凭据。"/>

        <Border Margin="0,14,0,0" Padding="16,12,16,12" CornerRadius="6" BorderThickness="1"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}">
            <StackPanel>
                <TextBlock Text="正在读取的位置" FontWeight="SemiBold"/>
                <TextBlock x:Name="EmptyLine" Margin="0,8,0,2" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="还没有：这台电脑上没找到 DSH_HOME 或 .dsh，也还没添加文件夹。"/>
                <ItemsControl x:Name="HomeList" Margin="0,6,0,0" Focusable="False"
                              AutomationProperties.Name="DeepSeek Harness 的数据目录">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4,0,4">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                        Content="移除" Margin="12,0,0,0" Click="Remove_Click"
                                        Visibility="{Binding RemoveVisibility}"
                                        AutomationProperties.Name="{Binding RemoveName}"
                                        ToolTip="不再读这个文件夹；列表里已有的这些会话照样保留"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                    <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusLine" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{StaticResource MutedBrush}"/>

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="添加文件夹…" IsDefault="True" MinWidth="120" Click="Add_Click"
                    Style="{StaticResource ClaudeButton}"/>
            <Button Content="完成" IsCancel="True" MinWidth="88" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
