<Window x:Class="ClaudeLauncher.App.GroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设为分组" Height="440" Width="460" MinHeight="320" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="PromptLine" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="19"/>

        <TextBox Grid.Row="1" x:Name="NameBox" Padding="8,6" MaxLength="40"
                 AutomationProperties.Name="分组名"
                 TextChanged="NameBox_TextChanged" PreviewKeyDown="NameBox_PreviewKeyDown"/>

        <!-- Says which of the two it will be before Enter is pressed: a new group spelled a
             little differently from an existing one is the mistake worth catching. -->
        <TextBlock Grid.Row="2" x:Name="OutcomeLine" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"/>

        <TextBlock Grid.Row="3" x:Name="ExistingLine" Foreground="{StaticResource FaintBrush}" FontSize="12"
                   Margin="2,12,0,5"/>

        <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="ExistingList" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextBrush}" AutomationProperties.Name="已有分组"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ExistingList_SelectionChanged"
                     MouseDoubleClick="ExistingList_MouseDoubleClick"
                     PreviewKeyDown="ExistingList_PreviewKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Padding" Value="9,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                            CornerRadius="3" Margin="3,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DialogRowHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0} 条}"
                                       Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="12,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Text="只改本工具的分组，可撤销"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="确定" IsDefault="True" MinWidth="88" Click="Ok_Click"
                        Style="{StaticResource ClaudeButton}"/>
                <Button Content="取消" IsCancel="True" MinWidth="88" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
