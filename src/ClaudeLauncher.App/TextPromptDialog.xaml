<Window x:Class="ClaudeLauncher.App.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名" Width="480" SizeToContent="Height" MinWidth="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <StackPanel Margin="18,16,18,14">
        <TextBlock x:Name="PromptLine" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="19"/>

        <TextBox x:Name="InputBox" Padding="8,6" AutomationProperties.Name="输入"
                 PreviewKeyDown="InputBox_PreviewKeyDown"/>

        <TextBlock x:Name="HintLine" FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}"/>

        <DockPanel Margin="0,14,0,0">
            <Button x:Name="ClearButton" DockPanel.Dock="Left" Style="{StaticResource LinkButton}"
                    VerticalAlignment="Center" Visibility="Collapsed" Click="Clear_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="保存" IsDefault="True" MinWidth="88" Click="Ok_Click"
                        Style="{StaticResource ClaudeButton}"/>
                <Button Content="取消" IsCancel="True" MinWidth="88" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
