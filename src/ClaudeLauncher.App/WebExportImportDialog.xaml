<Window x:Class="ClaudeLauncher.App.WebExportImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入网页版的对话" Width="600" SizeToContent="Height" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <StackPanel Margin="20,18,20,16">
        <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="Intro" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20"
                   Foreground="{StaticResource SubtleTextBrush}"/>

        <Border Margin="0,14,0,0" Padding="16,12,16,14" CornerRadius="6" BorderThickness="1"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="OpenSiteButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                            VerticalAlignment="Center" Click="OpenSite_Click"/>
                    <TextBlock x:Name="StepsHeading" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- The steps, filled in for the app: a number, then what to do. -->
                <Grid x:Name="Steps" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <TextBlock x:Name="Note" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusLine" Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="19"
                   Foreground="{StaticResource MutedBrush}"/>

        <Border x:Name="FoundPanel" Margin="0,12,0,0" Padding="12,9,12,10" CornerRadius="6" BorderThickness="1"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="导入这一份" MinWidth="96" Margin="12,0,0,0" VerticalAlignment="Center"
                        Click="ImportFound_Click" ToolTip="导入下载文件夹里找到的这份导出"/>
                <TextBlock x:Name="FoundText" TextWrapping="Wrap" LineHeight="19" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <DockPanel Margin="0,16,0,0">
            <Button x:Name="RemoveButton" DockPanel.Dock="Left" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                    Content="移除已导入的记录…" Visibility="Collapsed" Click="Remove_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="选择导出文件…" IsDefault="True" MinWidth="120" Click="Choose_Click"
                        Style="{StaticResource ClaudeButton}"/>
                <Button Content="关闭" IsCancel="True" MinWidth="88" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
